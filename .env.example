# Copiare in .env alla radice; non inserire segreti nel frontend.
AI_PROVIDER=mock
# Per un provider reale: AI_PROVIDER=openai e credenziali/modello del provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
FRONTEND_ORIGIN=http://localhost:5173
